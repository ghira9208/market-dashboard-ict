__pycache__/
*.pyc
.DS_Store
# Bulk, regenerable OHLCV disk caches only — NOT the small accumulating
# history logs that live alongside them (institutional_bias_history.json,
# market_cap_history.json, news_history.json under .cache/, trials.jsonl
# under edge_lab/.cache/). Those are exactly what the scheduled GitHub
# Actions collector (see .github/workflows/collect.yml) exists to grow
# over real calendar time — gitignoring them would silently throw away
# every day's snapshot the moment the workflow's own runner exits, since
# nothing else persists them. research/.cache/ stays fully ignored: it's
# ~250MB of the same kind of regenerable per-ticker OHLCV cache, no
# small logs mixed in worth carving out.
research/.cache/
.cache/ohlcv/
.streamlit/secrets.toml
*.log
.last_state*.json
*.pre_fill_fix_backup_*.db
*.pre_merge_stale_cleanup_*.db
# Isolated venv for the cTrader Open API integration -- kept separate from
# the main environment specifically because ctrader-open-api pulls in an
# old protobuf (3.20.1) that conflicts with streamlit's own requirement
# (>=5.26.1) -- confirmed directly, installing it system-wide downgraded
# protobuf and would have broken every app on next restart.
.venv_ctrader/
# Live OAuth tokens, not a data log -- unlike the small accumulating
# .cache/*.json history files this project deliberately tracks, this one
# is a real, rotating credential (see ctrader_auth.py).
.cache/ctrader_tokens.json
